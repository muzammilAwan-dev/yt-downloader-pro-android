<?xml version="1.0" encoding="utf-8"?>
<!-- Android expands layers by 1.5x. One-sixth inset per edge restores the desktop tile's visible scale. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background>
        <shape android:shape="rectangle">
            <solid android:color="#180F0F" />
        </shape>
    </background>
    <foreground>
        <inset android:inset="16.67%">
            <bitmap
                android:src="@drawable/ytdlp_icon"
                android:gravity="fill"
                android:filter="true" />
        </inset>
    </foreground>
</adaptive-icon>
