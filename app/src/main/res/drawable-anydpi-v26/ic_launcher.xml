<?xml version="1.0" encoding="utf-8"?>
<!-- Same owner artwork; Android applies its launcher mask. The red symbol fits the inner safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background>
        <shape android:shape="rectangle">
            <solid android:color="#180F0F" />
        </shape>
    </background>
    <foreground>
        <bitmap
            android:src="@drawable/ytdlp_icon"
            android:gravity="fill"
            android:filter="true" />
    </foreground>
</adaptive-icon>
