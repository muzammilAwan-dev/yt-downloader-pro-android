<?xml version="1.0" encoding="utf-8"?>
<!-- No backup and no device transfer: task history, cookies and logs must never leave the device on their own. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
